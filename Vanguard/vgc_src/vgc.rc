/*
 * vgc.rc
 * Resource script for vgc.exe matching official C:\vgc.exe metadata
 */

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,19,1,18
 PRODUCTVERSION 1,19,1,18
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Riot Games, Inc."
            VALUE "FileDescription",  "Vanguard User-mode Service"
            VALUE "FileVersion",      "1.19.1-18+20261001.143443"
            VALUE "InternalName",     "vgc.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2019-2026 Riot Games, Inc."
            VALUE "OriginalFilename", "vgc.exe"
            VALUE "ProductName",      "Vanguard Client"
            VALUE "ProductVersion",   "1.19.1-18+20261001.143443"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
